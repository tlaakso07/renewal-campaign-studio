{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 800,
      "includeFiles": "{dist/**,product/model-inventory.json,vendor/fonts/**,node_modules/ffmpeg-static/ffmpeg,node_modules/ffprobe-static/bin/linux/x64/ffprobe}",
      "excludeFiles": "{research/**,library/**,product/ui-concepts/**,tests/**,.runtime/**,.env*,node_modules/ffprobe-static/bin/darwin/**,node_modules/ffprobe-static/bin/win32/**}"
    }
  },
  "routes": [{ "src": "/(.*)", "dest": "/api/index" }]
}
