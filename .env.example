# Copy to .env; local identity must be explicitly enabled. Never use for hosting.
APP_ENV=development
DEV_AUTH=true
PORT=8787
DATA_DIR=.runtime
# Optional server-side Drive token, obtained through your authorized Google application.
GOOGLE_DRIVE_ACCESS_TOKEN=
# Vercel deployments authenticate to AI Gateway with OIDC automatically.
# Local development can use a Gateway key; never expose it to the browser.
AI_GATEWAY_API_KEY=
ASSISTANT_MODEL_ID=openai/gpt-6-astra
# Higgsfield server credentials in KEY_ID:KEY_SECRET format. API billing is separate from the website subscription.
HIGGSFIELD_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_REDIRECT_URI=
# No prices or retention policy have been selected for launch.

# Vercel AI Gateway key for local GPT Image generation and the assistant (hosted Vercel uses OIDC).
AI_GATEWAY_API_KEY=
# Optional: vision model that proofreads generated ads.
AD_CHECK_MODEL=
