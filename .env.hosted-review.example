# Configure these only in the protected Vercel project's Production environment.
# Never enable DEV_AUTH in hosting. Do not put secrets in VITE_* variables.
APP_ENV=hosted-review
DEV_AUTH=false
REVIEW_STATE_KEY=review/state-v1.json
BLOB_READ_WRITE_TOKEN=
REVIEW_PASSWORD_HASH=
REVIEW_COOKIE_SECRET=

# Vercel supplies VERCEL=1 and NODE_ENV=production.
# Generate the password hash with server/review-access.ts:passwordHash.
# Use a cryptographically random cookie secret of at least 32 characters.
# Keep access instructions in ignored private storage, never in this file.
